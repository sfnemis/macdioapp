.git
.gitignore
.DS_Store
wrangler.jsonc
worker.js
CNAME

# Wrangler's own state and deploy temp files. Without this they are published
# as public assets: the account cache and the worker sourcemap were both
# reachable on macdio.app until 2026-08-20.
.wrangler
*.map

# Agent instructions and internal specs. Both were reachable on macdio.app:
# /CLAUDE.local.md and /docs/superpowers/specs/*.md both answered 200 on
# 2026-09-14, publishing local filesystem paths and internal notes.
CLAUDE.md
CLAUDE.local.md
docs

# Local backups that must never reach the CDN
*.onceki
*.bak
*.zip
