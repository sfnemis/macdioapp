{
  // Cloudflare Workers static assets config for macdio.app
  //
  // "directory" is ./public and must stay that way. It used to be ".", which
  // made the whole repository the public web root, and every file was served
  // until .assetsignore happened to name it. That leaked the wrangler account
  // cache, the worker sourcemap, CLAUDE.local.md, docs/ and .serena/ across
  // three separate incidents. Anything outside ./public cannot ship now.
  // Deploy: npx wrangler deploy   (needs `npx wrangler login` once)
  // Custom domain: add macdio.app under Workers > macdio-web > Settings > Domains & Routes
  "name": "macdio-web",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",

  // macdio.app is a custom domain, so the workers.dev subdomain served
  // nothing but a second public copy of the site: macdio-web.sfn-test
  // .workers.dev answered 200, and so did a preview URL per retained
  // version, eleven hostnames on 2026-09-14. Any future mistake would have
  // been exposed on all of them, and each one is a host that ignores the
  // canonical the pages carry.
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "binding": "ASSETS"
  },

  // Both domains were attached in the dashboard and named nowhere in the repo,
  // so `wrangler deploy` ended with "No targets deployed for macdio-web" and
  // the routing lived only in a web UI. Declared here it survives a rebuild.
  // www.macdio.app 301s to the apex.
  "routes": [
    { "pattern": "macdio.app", "custom_domain": true },
    { "pattern": "www.macdio.app", "custom_domain": true }
  ],

  // Nothing was recorded while /CLAUDE.local.md was public, so there is no way
  // to know whether anyone fetched it. Logs cost nothing at this traffic.
  "observability": { "enabled": true }
}
