/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Media and images. Long lived but not immutable, because a file can be
# replaced under the same name.
/assets/*
  Cache-Control: public, max-age=2592000

# Root scripts and styles carry no version hash, so they must revalidate on
# every visit. Otherwise a deploy takes days to reach returning visitors.
/redesign.js
  Cache-Control: public, max-age=0, must-revalidate

/redesign.css
  Cache-Control: public, max-age=0, must-revalidate

/parts.js
  Cache-Control: public, max-age=0, must-revalidate
