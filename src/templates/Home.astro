---
// Home: Workbench macrostructure on the late-night radio theme. A split
// opener (serif statement, CSS tuner apparatus), the dated numbers, a guided
// tour of the app in use (one real capture per block), the other screens,
// the community hub feed, how the business works, the comparison links,
// questions people search for, and the author line.
import Base from '../layouts/Base.astro';
import Clip from '../components/Clip.astro';
import Tuner from '../components/Tuner.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import StatStrip from '../components/StatStrip.astro';
import HubFeed from '../components/HubFeed.astro';
import Faq from '../components/Faq.astro';
import AuthorLine from '../components/AuthorLine.astro';
import counts from '../data/counts.json';
import pricing from '../../public/pricing.json';
import { t } from '../i18n/index.mjs';
import { localePath } from '../site/paths.mjs';
import { formatCount } from '../site/format.mjs';
import { softwareApplication, faqPage, webSite } from '../site/jsonld.mjs';
const { lang } = Astro.props;
const s = t(lang);
const h = s.home;
const page = s.pages['/'];
const lede = h.lede.replace('{stations}', formatCount(counts.stations, lang)).replace('{podcasts}', formatCount(counts.podcasts, lang));
const faq = h.faq.map((f) => ({ q: f.q, a: f.a }));
const jsonld = [webSite(lang), softwareApplication(lang, counts, pricing), faqPage(faq)];
const p = (english) => localePath(lang, english);
---
<Base lang={lang} path="/" title={page.title} description={page.description} jsonld={jsonld}>
  <div class="hero-band"><section class="hero wrap">
    <div class="hero__text">
      <img class="hero__icon" src="/icon-512.png" width="56" height="56" alt="">
      <p class="meta hero__meta">{h.eyebrow}</p>
      <h1>{h.h1} <span class="accent-phrase">{h.h1Accent}</span></h1>
      <p class="hero__lede">{lede}</p>
      <div class="hero__cta"><AppStoreButton lang={lang} /><a class="btn btn--chip" href="#tour">{h.secondary}</a></div>
    </div>
    <div class="hero__media"><Tuner /></div>
  </section></div>

  <StatStrip lang={lang} />

  <section id="tour" class="tour wrap" aria-label={h.tourLabel}>
    {h.tour.map((b, i) => (
      <article class:list={['tour__block', { 'tour__block--flip': i % 2 === 1 }]}>
        <Clip name={b.clip} caption={b.caption} />
        <div class="tour__text"><h2>{b.h} <span class="accent-phrase">{b.hAccent}</span></h2><p>{b.p}</p></div>
      </article>
    ))}
    <aside class="player"><span class="player__lamp"></span><span class="meta player__meta">{h.h1} {h.h1Accent}</span><AppStoreButton lang={lang} variant="fill" /></aside>
  </section>

  <div class="band"><section class="screens wrap">
    <div class="head-hang"><h2>{h.screens.h} <span class="accent-phrase">{h.screens.hAccent}</span></h2><p>{h.screens.p}</p></div>
    <div class="screens__row">{h.screens.items.map((it) => <Clip name={it.clip} caption={it.caption} />)}</div>
  </section></div>

  <HubFeed lang={lang} />

  <section class="business wrap">
    <div class="prose">
      <h2>{h.business.h} <span class="accent-phrase">{h.business.hAccent}</span></h2>
      <p>{h.business.p}</p>
      <p>{h.compare.h}: {h.compare.items.map((c, i) => <Fragment><a class="link" href={p(c.path)}>{c.label}</a>{i < h.compare.items.length - 1 ? ', ' : '.'}</Fragment>)}</p>
    </div>
  </section>

  <Faq items={faq} heading={s.site.faqHeading} />
  <AuthorLine lang={lang} checkedOn={counts.checkedOn} />
</Base>
<style>
  .hero-band { position: relative; overflow: clip; }
  .hero-band::before { content: ""; position: absolute; inset: 0; background: var(--grad-bloom); pointer-events: none; }
  .hero { position: relative; display: grid; gap: var(--space-2xl); padding-block: var(--space-xl) var(--space-2xl); align-items: center; }
  .hero__icon { border-radius: 14px; margin-block-end: var(--space-md); box-shadow: var(--shadow-soft); }
  .hero__meta { margin-block-end: var(--space-md); }
  .hero__text h1 { max-inline-size: 13ch; font-size: clamp(2.75rem, 5.2vw + 1rem, 5.25rem); }
  .hero__lede { font-size: var(--text-md); color: var(--color-ink-2); max-inline-size: 46ch; margin-block-start: var(--space-lg); }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); margin-block-start: var(--space-xl); }
  .hero__media { display: grid; justify-items: center; }
  .tour { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3xl); padding-block: var(--space-3xl); position: relative; }
  .tour__block { display: grid; gap: var(--space-lg); align-items: center; }
  .tour__block :global(figure) { max-inline-size: 17rem; }
  .tour__block :global(video) { box-shadow: var(--shadow-soft); }
  .tour__text { max-inline-size: 36ch; }
  .tour__text h2 { font-size: var(--text-3xl); }
  .tour__text p { margin-block-start: var(--space-md); color: var(--color-ink-2); font-size: var(--text-md); }
  .player { position: sticky; inset-block-end: var(--space-sm); display: flex; align-items: center; gap: var(--space-md); padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-md); background: var(--color-paper-2); border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-pill); z-index: var(--z-sticky); box-shadow: var(--shadow-soft); }
  .player__lamp { inline-size: 8px; block-size: 8px; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 12px 2px var(--color-glow); flex-shrink: 0; }
  .player__meta { min-inline-size: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--color-ink-2); }
  .player :global(.btn) { margin-inline-start: auto; }
  @media (max-width: 40rem) { .player__meta { display: none; } }
  .screens { padding-block: var(--space-xl) var(--space-2xl); }
  .screens__row { display: grid; gap: var(--space-lg); grid-template-columns: minmax(0, 1fr); }
  .screens__row :global(figure:nth-of-type(2)) { max-inline-size: 14rem; justify-self: center; }
  .business { padding-block: var(--space-2xl); }
  .business h2 { margin-block-start: 0; }
  @media (min-width: 60rem) {
    .hero { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-3xl); padding-block: var(--space-xl) var(--space-3xl); }
    .hero__media { justify-items: end; }
    .tour__block { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-3xl); }
    .tour__block--flip > :global(:first-child) { order: 2; }
    .tour__block :global(figure) { max-inline-size: 19rem; justify-self: center; }
    .tour__block :global(figure[data-clip^="mac-"]) { max-inline-size: 30rem; }
    .screens__row { grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 1.4fr); align-items: center; }
  }
</style>
