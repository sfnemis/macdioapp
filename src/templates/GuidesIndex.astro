---
// The guide hub index, rendered with the full Starlight chrome (sidebar,
// search, theme). It lives in src/pages so its URL is exactly
// /guides/index.html; Starlight would build a content index as /guides.html.
// Until a locale's guide strings exist (F4) the English text is shown, as
// Starlight does for untranslated content pages.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
const title = 'Macdio Guides';
const description = 'How to listen, record, identify and read along with radio and podcasts in Macdio on iPhone, iPad, Mac, Apple TV, Apple Watch and CarPlay.';
---
<StarlightPage frontmatter={{ title, description }}>
  <p>Guides for Macdio, the radio and podcast app for Apple devices. Each guide answers one question and names the devices it applies to.</p>
  <p>The guide hub is being rebuilt. The nine existing guides return in the next step with their original addresses.</p>
</StarlightPage>
