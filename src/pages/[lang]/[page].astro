---
// Every live locale except English: the pages its folder under src/legacy/
// holds. "index" is the locale home, written as <lang>/index.html, the file
// the Worker serves for /<lang>/.
import Legacy from '../../layouts/Legacy.astro';
import { liveLocales, DEFAULT } from '../../site/locales.mjs';
import { legacyPages, loadPage } from '../../site/legacy.mjs';
export function getStaticPaths() {
  return liveLocales().filter((l) => l.code !== DEFAULT).flatMap((l) =>
    legacyPages(l.code).filter((p) => /^\/([^/]+\.html)?$/.test(p)).map((p) => ({ params: { lang: l.code, page: p === '/' ? 'index' : p.slice(1, -5) } })));
}
const { lang, page } = Astro.params;
const path = page === 'index' ? '/' : `/${page}.html`;
---
<Legacy lang={lang} path={path} page={loadPage(lang, path)} />
