---
import Legacy from '../../../layouts/Legacy.astro';
import { liveLocales, DEFAULT } from '../../../site/locales.mjs';
import { legacyPages, loadPage } from '../../../site/legacy.mjs';
export function getStaticPaths() {
  return liveLocales().filter((l) => l.code !== DEFAULT).flatMap((l) =>
    legacyPages(l.code).filter((p) => p.startsWith('/guides/')).map((p) => ({ params: { lang: l.code, page: p === '/guides/' ? 'index' : p.slice('/guides/'.length, -5) } })));
}
const { lang, page } = Astro.params;
const path = page === 'index' ? '/guides/' : `/guides/${page}.html`;
---
<Legacy lang={lang} path={path} page={loadPage(lang, path)} />
