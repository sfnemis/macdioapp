---
// Under build.format "file" the route /guides/index is written as
// guides/index.html, which keeps the live URL /guides/ exactly.
import Legacy from '../../layouts/Legacy.astro';
import { legacyPages, loadPage } from '../../site/legacy.mjs';
export function getStaticPaths() {
  return legacyPages('en').filter((p) => p.startsWith('/guides/')).map((p) => ({ params: { page: p === '/guides/' ? 'index' : p.slice('/guides/'.length, -5) } }));
}
const { page } = Astro.params;
const path = page === 'index' ? '/guides/' : `/guides/${page}.html`;
---
<Legacy lang="en" path={path} page={loadPage('en', path)} />
