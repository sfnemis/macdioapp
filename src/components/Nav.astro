---
// N11 mega-menu on <details>: works with no JavaScript (plain disclosure
// lists), the inline script only adds outside-click and Escape dismissal.
// Below 60rem the desktop groups are hidden and one "Menu" disclosure
// carries the same links as a flat list (a second, mobile-only copy).
import { localePath } from '../site/paths.mjs';
import { t } from '../i18n/index.mjs';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import AppStoreButton from './AppStoreButton.astro';
const { lang, path } = Astro.props;
const s = t(lang);
const p = (english) => localePath(lang, english);
const groups = [
  { key: 'platforms', label: s.nav.platforms, items: s.nav.platformItems },
  { key: 'features', label: s.nav.features, items: s.nav.featureItems },
];
const plain = [
  { label: s.nav.guides, href: p('/guides/') },
  { label: s.nav.pricing, href: p('/pricing.html') },
  { label: s.nav.community, href: 'https://hub.devdio.pro' },
];
---
<header class="nav wrap">
  <a class="skip" href="#main">{s.nav.skip}</a>
  <div class="nav__bar">
    <a class="nav__brand" href={p('/')} aria-label={s.site.name}><img src="/icon-192.png" alt="" width="28" height="28"><span>{s.site.name}</span></a>
    <nav class="nav__groups" aria-label={s.nav.menu}>
      {groups.map((g) => (
        <details class="mega" name="mega">
          <summary class="nav__link">{g.label}</summary>
          <div class="mega__panel">
            <ul class="mega__list">
              {g.items.map((it) => (
                <li><a class="mega__item" href={p(it.path)}><b>{it.label}</b><span class="muted">{it.blurb}</span></a></li>
              ))}
            </ul>
          </div>
        </details>
      ))}
      {plain.map((l) => <a class="nav__link" href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a>)}
    </nav>
    <div class="nav__right">
      <ThemeToggle lang={lang} />
      <details class="mega mega--tools" name="mega">
        <summary class="nav__link"><span class="visually-hidden">{s.nav.language}: </span>{lang.toUpperCase()}</summary>
        <div class="mega__panel mega__panel--narrow"><LangSwitcher lang={lang} path={path} /></div>
      </details>
      <AppStoreButton lang={lang} variant="fill" />
      <details class="mega drawer" name="mega">
        <summary class="nav__link nav__menu" aria-label={s.nav.menu}>{s.nav.menu}</summary>
        <nav class="drawer__panel" aria-label={s.nav.menu}>
          {groups.map((g) => (
            <div class="drawer__group">
              <p class="drawer__head">{g.label}</p>
              <ul class="mega__list">{g.items.map((it) => <li><a class="mega__item" href={p(it.path)}><b>{it.label}</b><span class="muted">{it.blurb}</span></a></li>)}</ul>
            </div>
          ))}
          <ul class="mega__list drawer__plain">{plain.map((l) => <li><a class="mega__item" href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}><b>{l.label}</b></a></li>)}</ul>
        </nav>
      </details>
    </div>
  </div>
</header>
<script is:inline>
  // Close an open menu panel on outside click or Escape. The menu works
  // without this (details/summary); this only adds the expected dismissal.
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.mega[open]').forEach((d) => { if (!d.contains(e.target)) d.removeAttribute('open'); });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll('details.mega[open]').forEach((d) => d.removeAttribute('open'));
  });
</script>
<style>
  .nav { position: relative; z-index: var(--z-dropdown); }
  .nav__bar { display: flex; align-items: center; gap: var(--space-md); padding-block: var(--space-sm); border-block-end: var(--rule-hair) solid var(--color-rule-2); }
  .nav__brand { display: inline-flex; align-items: center; gap: var(--space-xs); color: var(--color-ink); text-decoration: none; font-weight: 700; white-space: nowrap; flex-shrink: 0; }
  .nav__brand img { border-radius: var(--radius-sm); }
  .nav__groups { display: none; align-items: center; gap: var(--space-md); margin-inline-start: var(--space-sm); }
  .nav__right { margin-inline-start: auto; display: flex; align-items: center; gap: var(--space-xs); }
  .nav__link { color: var(--color-ink-2); text-decoration: none; white-space: nowrap; cursor: pointer; list-style: none; padding: var(--space-xs) var(--space-2xs); border-radius: var(--radius-sm); }
  .nav__link::-webkit-details-marker { display: none; }
  .nav__link:hover { color: var(--color-ink); }
  .mega { position: relative; }
  .mega[open] > .nav__link { color: var(--color-ink); }
  .mega__panel, .drawer__panel { position: absolute; inset-inline-start: 0; inset-block-start: calc(100% + var(--space-xs)); min-inline-size: 22rem; background: var(--color-paper); border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-md); padding: var(--space-md); box-shadow: 0 12px 32px -16px oklch(from var(--color-ink) l c h / 0.25); }
  .mega__panel--narrow { min-inline-size: 12rem; inset-inline-start: auto; inset-inline-end: 0; }
  .mega__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2xs); }
  .mega__item { display: grid; gap: var(--space-3xs); padding: var(--space-xs) var(--space-sm); border-radius: var(--radius-sm); color: var(--color-ink); text-decoration: none; }
  .mega__item:hover { background: var(--color-paper-2); color: var(--color-ink); }
  .mega__item b { font-weight: 600; }
  .mega__item span { font-size: var(--text-sm); }
  .drawer { display: none; }
  .drawer__panel { inset-inline-start: auto; inset-inline-end: 0; min-inline-size: min(22rem, calc(100vw - 2 * var(--page-gutter))); display: grid; gap: var(--space-md); max-block-size: calc(100dvh - 6rem); overflow: auto; }
  .drawer__head { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-muted); margin: 0 0 var(--space-2xs) var(--space-sm); }
  .drawer__plain { border-block-start: var(--rule-hair) solid var(--color-rule-2); padding-block-start: var(--space-xs); }
  @media (min-width: 60rem) {
    .nav__groups { display: flex; }
    .nav__bar { gap: var(--space-lg); padding-block: var(--space-md); }
    .nav__right { gap: var(--space-sm); }
  }
  @media (max-width: 59.99rem) {
    .drawer { display: block; }
    .btn--fill { padding-inline: var(--space-sm); }
  }
  @media (max-width: 26rem) {
    /* Phones: the brand is its icon (the link keeps the name as aria-label), the store button its short label. */
    .nav__brand span { display: none; }
    .nav__right .btn--fill { font-size: var(--text-sm); }
  }
</style>
