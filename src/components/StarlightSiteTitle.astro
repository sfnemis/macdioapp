---
// Replaces Starlight's SiteTitle: its default links the locale root through
// Starlight's path formatter, which under build.format "file" becomes
// "/tr.html" (a 404). This links the real locale home (/, /tr/, ...).
import { localePath } from '../site/paths.mjs';
const { siteTitle, locale } = Astro.locals.starlightRoute;
const code = locale ?? 'en';
---
<a href={localePath(code, '/')} class="site-title">{siteTitle}</a>
<style>
  .site-title { color: var(--sl-color-text-accent); font-weight: 600; text-decoration: none; white-space: nowrap; }
</style>
