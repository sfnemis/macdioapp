---
// T4 numbered stat strip: real, dated numbers from counts.json and pricing.json.
import counts from '../data/counts.json';
import pricing from '../../public/pricing.json';
import { t } from '../i18n/index.mjs';
import { formatCount, price, countries, longDate } from '../site/format.mjs';
const { lang } = Astro.props;
const s = t(lang);
const fill = (str) => str
  .replace('{stations}', formatCount(counts.stations, lang))
  .replace('{podcasts}', formatCount(counts.podcasts, lang))
  .replace('{price}', price(pricing, 'US', 'en').text)
  .replace('{countries}', String(countries(pricing)));
---
<section class="stats wrap tnum" aria-label={s.home.statsLabel}>
  <ul>
    {s.home.stats.map((st) => <li><b>{fill(st.value)}</b><span>{fill(st.label)}</span></li>)}
  </ul>
  <p class="muted small">{s.hub.asOf} {longDate(counts.checkedOn, lang)}.</p>
</section>
<style>
  .stats { padding-block: var(--space-xl); }
  .stats ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg) var(--space-md); border-block: var(--rule-hair) solid var(--color-rule); padding-block: var(--space-lg); }
  .stats li { display: grid; gap: var(--space-3xs); min-inline-size: 0; }
  .stats b { font-family: var(--font-display); font-size: clamp(1.5rem, 6.5vw, var(--text-2xl)); font-weight: 700; letter-spacing: -0.02em; line-height: 1; white-space: nowrap; }
  .stats span { color: var(--color-muted); font-size: var(--text-sm); }
  .stats p { margin-block-start: var(--space-sm); }
  @media (min-width: 60rem) { .stats ul { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
