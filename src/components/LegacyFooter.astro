---
// The live site's footer, plus the language switcher (tracker W4): a select
// listing every live locale, pointing at this page in that language when it
// exists and at the locale home otherwise. parts.js keeps the choice in the
// "lang" cookie the Worker reads at "/".
import { t } from '../i18n/index.mjs';
import { localePath } from '../site/paths.mjs';
import { hasPage } from '../site/legacy.mjs';
import { liveLocales } from '../site/locales.mjs';
import LegacySocials from './LegacySocials.astro';
const { lang, path = '/' } = Astro.props;
const s = t(lang);
const home = localePath(lang, '/');
const p = (target) => (hasPage(lang, target) ? localePath(lang, target) : target);
const options = liveLocales().map((l) => ({ code: l.code, label: l.label, href: hasPage(l.code, path) ? localePath(l.code, path) : localePath(l.code, '/') }));
---
<footer class="footer"><div class="wrap">
  <a class="footer-brand" href={home}><img src="/icon-192.png" alt="Macdio" width="192" height="192"><span>Macdio</span></a>
  <a class="footer-devdio" href="https://devdio.pro" target="_blank" rel="noopener"><img src="/assets/devdio-mark.svg" alt="Devdio" width="15" height="15">{s.footer.copyright}</a>
  <nav class="footer-nav">
    <a href={p('/support.html')}>{s.footer.support}</a>
    <a href={p('/privacy.html')}>{s.footer.privacy}</a>
    <a href={p('/presskit.html')}>{s.footer.presskit}</a>
    <a href="mailto:support@devdio.pro">{s.footer.contact}</a>
  </nav>
  {options.length > 1 && <label class="lang-select"><span class="vh">{s.footer.language}</span><select id="langSelect" aria-label={s.footer.language}>{options.map((o) => <option value={o.code} data-href={o.href} selected={o.code === lang}>{o.label}</option>)}</select></label>}
  <div class="footer-socials"><LegacySocials lang={lang} /></div>
</div></footer>
