---
// Starlight's footer (last updated, previous/next) with the author line every
// guide carries: who wrote it and when it was last checked.
import Default from '@astrojs/starlight/components/Footer.astro';
import { t } from '../i18n/index.mjs';
import { byCode } from '../site/locales.mjs';
import { localePath } from '../site/paths.mjs';
const { entry, locale } = Astro.locals.starlightRoute;
const code = locale ?? 'en';
const g = t(code).guides;
const checked = entry.data.lastUpdated instanceof Date ? entry.data.lastUpdated : null;
const date = checked ? checked.toLocaleDateString(byCode(code).lang, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
const line = g.writtenBy.replace(/href="(\/[^"]*)"/g, (m, p) => `href="${localePath(code, p)}"`) + (date ? ' ' + g.checkedOn.replace('{date}', date) : '');
---
<p class="guide-author" set:html={line} />
<Default {...Astro.props}><slot /></Default>
