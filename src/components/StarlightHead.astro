---
// Replaces Starlight's Head so guide pages carry the same canonical, hreflang
// and metadata rules as the marketing pages (Legacy.astro), plus the Article,
// FAQPage and BreadcrumbList JSON-LD the live guides had. Starlight's default
// wrote the canonical as /guides.html/ under build.format "preserve".
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { SITE, localePath, alternates, splitLocale } from '../site/paths.mjs';
import { byCode, DEFAULT } from '../site/locales.mjs';
import { guideLocales } from '../data/guides.mjs';
import { t } from '../i18n/index.mjs';

const { entry, siteTitle } = Astro.locals.starlightRoute;
// Astro.url.pathname is "/guides/" for the index route and "/guides/<slug>"
// for content pages; the served file for the latter is "<slug>.html".
let pathname = Astro.url.pathname;
if (pathname.endsWith('/index.html')) pathname = pathname.slice(0, -'index.html'.length);
else if (!pathname.endsWith('/') && !pathname.endsWith('.html')) pathname += '.html';
const { code, path } = splitLocale(pathname);
const locale = byCode(code);
const url = SITE + localePath(code, path);
const pageTitle = entry.data.title;
// A page may carry its own <title> in frontmatter head (the hub index keeps a
// short H1 and a longer search title); otherwise the H1 with the site name.
const custom = entry.data.head?.find((h) => h.tag === 'title')?.content;
const title = custom || (/Macdio/.test(pageTitle) ? pageTitle : `${pageTitle} | ${siteTitle}`);
const description = entry.data.description ?? '';
const image = 'https://macdio.app/assets/discourse/x-summary-large.png';
// A locale carries a guide when it is a guide locale (live, with translated
// guides) and, for a guide page, its Markdown file exists; the hub index
// (/guides/) is a route every guide locale has.
const guideCodes = new Set(guideLocales().map((l) => l.code));
const hasDoc = (c) => c === DEFAULT || (guideCodes.has(c) && (path.endsWith('/') || existsSync(join(process.cwd(), 'src', 'content', 'docs', c, path.replace(/\.html$/, '.md')))));
const alts = alternates(path, hasDoc);
const isGuide = path !== '/guides/';
const iso = (d) => (d instanceof Date ? d.toISOString().slice(0, 10) : undefined);
const author = { '@type': 'Person', name: 'Sait Firat NEMIS', url: 'https://macdio.app/presskit.html', sameAs: ['https://x.com/macdioapp', 'https://hub.devdio.pro'] };
const publisher = { '@type': 'Organization', name: 'Macdio', url: 'https://macdio.app', logo: { '@type': 'ImageObject', url: 'https://macdio.app/assets/app-icon.png', width: 512, height: 512 } };
const jsonld = [];
if (isGuide) {
  jsonld.push({ '@context': 'https://schema.org', '@type': 'Article', headline: pageTitle, description, datePublished: iso(entry.data.datePublished), dateModified: iso(entry.data.lastUpdated) ?? iso(entry.data.datePublished), author, publisher, mainEntityOfPage: { '@type': 'WebPage', '@id': url }, inLanguage: locale.lang });
  if (entry.data.faq?.length) jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: entry.data.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
}
// Crumb names in the page's language: the brand for the home page (the same
// word everywhere) and the guide hub's own heading.
const crumbs = [{ name: 'Macdio', item: SITE + localePath(code, '/') }, { name: t(code).guides.h1, item: SITE + localePath(code, '/guides/') }];
if (isGuide) crumbs.push({ name: pageTitle, item: url });
jsonld.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })) });
const badgeStrings = 'window.MACDIO_I18N=' + JSON.stringify({ badge: t(code).badge }).replace(/</g, '\\u003c') + ';';
---
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="SFN">
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
<link rel="canonical" href={url}>
{alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<meta property="og:site_name" content="Macdio">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:type" content={isGuide ? 'article' : 'website'}>
<meta property="og:image" content={image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content={locale.lang.replace('-', '_')}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@macdioapp">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>
<meta name="theme-color" content="#050507">
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon-180.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="sitemap" href="/sitemap-index.xml">
{jsonld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
<script is:inline set:html={badgeStrings} />
<script is:inline src="/hub-badge.js" defer></script>
<!-- GA4 on macdio.app only: localhost, wrangler dev and previews would otherwise count as visits. -->
<script is:inline>if(location.hostname==='macdio.app'){window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};gtag('js',new Date());gtag('config','G-QR2MZ9NF2N');var g=document.createElement('script');g.async=true;g.src='https://www.googletagmanager.com/gtag/js?id=G-QR2MZ9NF2N';document.head.appendChild(g);}</script>
