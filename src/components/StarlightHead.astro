---
// Replaces Starlight's Head so guide pages carry the same canonical, hreflang
// and metadata rules as the marketing pages (Legacy.astro), plus the Article,
// FAQPage and BreadcrumbList JSON-LD the live guides had. Starlight's default
// wrote the canonical as /guides.html/ under build.format "preserve".
import { SITE, localePath, alternates } from '../site/paths.mjs';
import { byCode } from '../site/locales.mjs';
import { hasGuide, guideRoute } from '../data/guides.mjs';
import { t } from '../i18n/index.mjs';
import AppStoreClicks from './AppStoreClicks.astro';

const { entry, siteTitle, isFallback } = Astro.locals.starlightRoute;
const { code, path } = guideRoute(Astro.url);
const locale = byCode(code);
// A guide not yet translated into this locale is Starlight's fallback: the
// English text under /<code>/guides/. It points to the English page as
// canonical and stays out of the index (and so out of the sitemap).
const url = SITE + localePath(isFallback ? 'en' : code, path);
const pageTitle = entry.data.title;
// A page may carry its own <title> in frontmatter head (the hub index keeps a
// short H1 and a longer search title); otherwise the H1 with the site name.
const custom = entry.data.head?.find((h) => h.tag === 'title')?.content;
// The brand goes after the guide's own title only while the whole stays
// within 60 characters (what search results show): "| Macdio Guides", then
// "| Macdio", then nothing. Titles that already name Macdio stay as they are.
const withBrand = [`${pageTitle} | ${siteTitle}`, `${pageTitle} | Macdio`].find((t) => t.length <= 60);
const title = custom || (/Macdio/.test(pageTitle) ? pageTitle : withBrand || pageTitle);
const description = entry.data.description ?? '';
const image = 'https://macdio.app/assets/discourse/x-summary-large.png';
// A locale carries a guide when it is a guide locale (live, with translated
// guides) and, for a guide page, its Markdown file exists; the hub index
// (/guides/) is a route every guide locale has.
const hasDoc = (c) => hasGuide(c, path);
const alts = alternates(path, hasDoc);
const isGuide = path !== '/guides/';
const iso = (d) => (d instanceof Date ? d.toISOString().slice(0, 10) : undefined);
const author = { '@type': 'Person', name: 'Sait Firat NEMIS', url: 'https://macdio.app/presskit.html', sameAs: ['https://x.com/devdiopro', 'https://www.instagram.com/devdiopro', 'https://www.youtube.com/@Devdiopro', 'https://www.tiktok.com/@devdiopro', 'https://hub.devdio.pro'] };
const publisher = { '@type': 'Organization', name: 'Macdio', url: 'https://macdio.app', logo: { '@type': 'ImageObject', url: 'https://macdio.app/assets/app-icon.png', width: 512, height: 512 } };
const jsonld = [];
if (isGuide) {
  jsonld.push({ '@context': 'https://schema.org', '@type': 'Article', headline: pageTitle, description, datePublished: iso(entry.data.datePublished), dateModified: iso(entry.data.lastUpdated) ?? iso(entry.data.datePublished), author, publisher, mainEntityOfPage: { '@type': 'WebPage', '@id': url }, inLanguage: locale.lang });
  if (entry.data.faq?.length) jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: entry.data.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
}
// Crumb names in the page's language: the brand for the home page (the same
// word everywhere) and the guide hub's own heading.
const crumbs = [{ name: 'Macdio', item: SITE + localePath(code, '/') }, { name: t(code).guides.h1, item: SITE + localePath(code, '/guides/') }];
if (isGuide) crumbs.push({ name: pageTitle, item: url });
jsonld.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })) });
---
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="SFN">
<meta name="robots" content={isFallback ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'}>
<link rel="canonical" href={url}>
{alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<meta property="og:site_name" content="Macdio">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:type" content={isGuide ? 'article' : 'website'}>
<meta property="og:image" content={image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content={locale.lang.replace('-', '_')}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@devdiopro">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>
<meta name="theme-color" content="#050507">
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon-180.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="sitemap" href="/sitemap-index.xml">
{jsonld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
<!-- Umami (self-hosted at stats.devdio.pro, tracker W29) counts visits without cookies; data-domains keeps local previews and test runs out. -->
<script is:inline defer src="https://stats.devdio.pro/script.js" data-website-id="cef17e25-0c90-4678-a353-b397a24ef5c5" data-domains="macdio.app"></script>
<!-- Session replay and heatmaps (W30): starts only after the counter above has a session, so never outside macdio.app. -->
<script is:inline defer src="https://stats.devdio.pro/recorder.js" data-website-id="cef17e25-0c90-4678-a353-b397a24ef5c5"></script>
<AppStoreClicks />
